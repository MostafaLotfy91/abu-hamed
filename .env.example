# Copy to .env and fill in for your Supabase project. Do not commit .env.
# Public values (bundled into the browser):
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-only values (never prefix with VITE_):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
LOVABLE_API_KEY=<AI gateway key>
# Rate limiting for AI endpoints (server-only). Salt: any long random string.
RATE_LIMIT_SALT=<random secret>
# Header holding the real client IP on your host (default: cf-connecting-ip for Cloudflare).
TRUSTED_IP_HEADER=cf-connecting-ip
