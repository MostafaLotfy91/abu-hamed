# Copy to .env and fill in for your Supabase project. Do not commit .env.
# Public values (bundled into the browser):
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-only values (never prefix with VITE_):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# AI assistant + admin insights (any OpenAI-compatible provider; Google Gemini free tier by default).
# Free key: https://aistudio.google.com/apikey  (Groq: AI_PROVIDER=groq, key from https://console.groq.com/keys)
AI_API_KEY=<ai provider key>
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# Rate limiting for AI endpoints (server-only). Salt: any long random string.
RATE_LIMIT_SALT=<random secret>
# Header holding the real client IP on your host (default: cf-connecting-ip for Cloudflare).
TRUSTED_IP_HEADER=cf-connecting-ip

# Web Push for the driver app (public key only; the private key goes in Edge Function secrets).
# Generate with: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=<vapid public key>
